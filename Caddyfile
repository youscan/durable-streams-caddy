{
	admin off
	auto_https off
}

:4437 {
	route /v1/stream/* {
		# Extension point. Drop snippets (basicauth, headers, CORS, IP
		# filters, request_body limits, etc.) into /etc/caddy/conf.d/*.caddy
		# to layer them in front of the durable_streams handler.
		# Glob with no matches is a silent no-op.
		import /etc/caddy/conf.d/*.caddy

		durable_streams {
			data_dir /data
		}
	}

	# Anything outside /v1/stream/* gets a clean 404 instead of Caddy's
	# implicit empty 200. `route` doesn't fall through, so this matcher
	# only fires for non-stream paths.
	@notstream not path /v1/stream/*
	respond @notstream 404
}
